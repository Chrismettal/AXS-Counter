<resources xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">
    <!--
        Action bindings for the bonus-button counter.

        Each property stores one binding as a single number:
            0   = unassigned
            1-8   = FS 1-8, short press
            9-16  = FS 1-8, long press   (binding = functionSet + 8)

        Defaults: increment = FS 3 short (both-buttons short press),
        decrement and reset unassigned.
    -->
    <properties>
        <property id="actionIncrement" type="number">3</property>
        <property id="actionDecrement" type="number">0</property>
        <property id="actionReset" type="number">0</property>
    </properties>

    <settings>
        <setting propertyKey="@Properties.actionIncrement" title="@Strings.SettingIncrementTitle">
            <settingConfig type="list">
                <listEntry value="0">@Strings.SettingUnassigned</listEntry>
                <listEntry value="1">@Strings.SettingFS1Short</listEntry>
                <listEntry value="9">@Strings.SettingFS1Long</listEntry>
                <listEntry value="2">@Strings.SettingFS2Short</listEntry>
                <listEntry value="10">@Strings.SettingFS2Long</listEntry>
                <listEntry value="3">@Strings.SettingFS3Short</listEntry>
                <listEntry value="11">@Strings.SettingFS3Long</listEntry>
                <listEntry value="4">@Strings.SettingFS4Short</listEntry>
                <listEntry value="12">@Strings.SettingFS4Long</listEntry>
                <listEntry value="5">@Strings.SettingFS5Short</listEntry>
                <listEntry value="13">@Strings.SettingFS5Long</listEntry>
                <listEntry value="6">@Strings.SettingFS6Short</listEntry>
                <listEntry value="14">@Strings.SettingFS6Long</listEntry>
                <listEntry value="7">@Strings.SettingFS7Short</listEntry>
                <listEntry value="15">@Strings.SettingFS7Long</listEntry>
                <listEntry value="8">@Strings.SettingFS8Short</listEntry>
                <listEntry value="16">@Strings.SettingFS8Long</listEntry>
            </settingConfig>
        </setting>

        <setting propertyKey="@Properties.actionDecrement" title="@Strings.SettingDecrementTitle">
            <settingConfig type="list">
                <listEntry value="0">@Strings.SettingUnassigned</listEntry>
                <listEntry value="1">@Strings.SettingFS1Short</listEntry>
                <listEntry value="9">@Strings.SettingFS1Long</listEntry>
                <listEntry value="2">@Strings.SettingFS2Short</listEntry>
                <listEntry value="10">@Strings.SettingFS2Long</listEntry>
                <listEntry value="3">@Strings.SettingFS3Short</listEntry>
                <listEntry value="11">@Strings.SettingFS3Long</listEntry>
                <listEntry value="4">@Strings.SettingFS4Short</listEntry>
                <listEntry value="12">@Strings.SettingFS4Long</listEntry>
                <listEntry value="5">@Strings.SettingFS5Short</listEntry>
                <listEntry value="13">@Strings.SettingFS5Long</listEntry>
                <listEntry value="6">@Strings.SettingFS6Short</listEntry>
                <listEntry value="14">@Strings.SettingFS6Long</listEntry>
                <listEntry value="7">@Strings.SettingFS7Short</listEntry>
                <listEntry value="15">@Strings.SettingFS7Long</listEntry>
                <listEntry value="8">@Strings.SettingFS8Short</listEntry>
                <listEntry value="16">@Strings.SettingFS8Long</listEntry>
            </settingConfig>
        </setting>

        <setting propertyKey="@Properties.actionReset" title="@Strings.SettingResetTitle">
            <settingConfig type="list">
                <listEntry value="0">@Strings.SettingUnassigned</listEntry>
                <listEntry value="1">@Strings.SettingFS1Short</listEntry>
                <listEntry value="9">@Strings.SettingFS1Long</listEntry>
                <listEntry value="2">@Strings.SettingFS2Short</listEntry>
                <listEntry value="10">@Strings.SettingFS2Long</listEntry>
                <listEntry value="3">@Strings.SettingFS3Short</listEntry>
                <listEntry value="11">@Strings.SettingFS3Long</listEntry>
                <listEntry value="4">@Strings.SettingFS4Short</listEntry>
                <listEntry value="12">@Strings.SettingFS4Long</listEntry>
                <listEntry value="5">@Strings.SettingFS5Short</listEntry>
                <listEntry value="13">@Strings.SettingFS5Long</listEntry>
                <listEntry value="6">@Strings.SettingFS6Short</listEntry>
                <listEntry value="14">@Strings.SettingFS6Long</listEntry>
                <listEntry value="7">@Strings.SettingFS7Short</listEntry>
                <listEntry value="15">@Strings.SettingFS7Long</listEntry>
                <listEntry value="8">@Strings.SettingFS8Short</listEntry>
                <listEntry value="16">@Strings.SettingFS8Long</listEntry>
            </settingConfig>
        </setting>
    </settings>
</resources>
